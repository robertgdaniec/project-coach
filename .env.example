# ==============================================================================
# Project Coach - Environment Configuration Template (Docker & Host)
# Skopiuj ten plik do .env i uzupełnij własnymi wartościami.
# ==============================================================================

# Ngrok Configuration (Tymczasowy tunel webhooków ze smartwatcha/internetu)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
NGROK_DOMAIN=your-static-subdomain.ngrok-free.dev

# Telegram Bot API (Dwukierunkowa komunikacja i transkrypcja notatek)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Gemini API Keys (Pula kluczy do automatycznego Failoveru przy 429)
GEMINI_API_KEYS=your_first_gemini_key,your_second_gemini_key
GEMINI_API_KEY=your_first_gemini_key
GEMINI_MODEL=gemini-3.6-flash

# FastAPI Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Docker & Hardware Acceleration Configuration
# WHISPER_DEVICE: 'cuda' (dla profilu GPU) lub 'cpu' (dla profilu CPU)
WHISPER_DEVICE=cuda
# KALISTENIKA_DIR: ścieżka do wolumenu z bazą danych (w kontenerze: /kalistenika)
KALISTENIKA_DIR=/kalistenika
