# ==============================================================================
# Project Coach - Environment Configuration Template
# Skopiuj ten plik do .env i uzupełnij własnymi kluczami.
# ==============================================================================

# Ngrok Configuration (Wymagane do odbioru webhooków ze smartwatcha/internetu)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
NGROK_DOMAIN=your-static-subdomain.ngrok-free.dev

# Telegram Bot API (Wymagane do dwukierunkowej komunikacji i transkrypcji notatek)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Gemini API Keys (Pula kluczy do automatycznego przełączania Failover przy 429)
# Klucze rozdzielone przecinkami (minimum 1, zalecane 2-3 z różnych projektów GCP)
GEMINI_API_KEYS=your_first_gemini_key,your_second_gemini_key
GEMINI_API_KEY=your_first_gemini_key
GEMINI_MODEL=gemini-3.6-flash

# FastAPI Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000

# Docker & Hardware Acceleration Configuration
# WHISPER_DEVICE: 'cuda' (dla profilu GPU z akceleracją RTX) lub 'cpu' (dla profilu CPU)
WHISPER_DEVICE=cuda
# KALISTENIKA_DIR: ścieżka do wolumenu z bazą danych (w kontenerze: /kalistenika, na Windows: opcjonalna)
KALISTENIKA_DIR=/kalistenika

